[Unit]
Description=Statusphere presence agent
Documentation=https://github.com/MAX1T1A/statusphere
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=statusphere
# Nothing to look at here, and metrics move slowly - see agent/README.md
ExecStart=/usr/local/bin/statusphere --ui headless --interval 30s
Restart=always
RestartSec=10s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Its own home, not just the config dir: the cache dir appears on first run, and
# a ReadWritePaths entry that does not exist yet fails the unit with 226/NAMESPACE
ReadWritePaths=/home/statusphere

[Install]
WantedBy=multi-user.target
